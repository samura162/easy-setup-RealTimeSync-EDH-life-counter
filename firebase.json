{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "members.txt",
        "headers": [
          { "key": "Cache-Control", "value": "max-age=60" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "!/@(firebaseConfig.js|members.txt)",
        "destination": "/index.html"
      }
    ]
  }
}
